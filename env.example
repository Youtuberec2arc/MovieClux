# Copy this file to .env for local development, or add the same
# keys under Vercel → Project → Settings → Environment Variables.
# NEVER commit a real .env file.

# Comma-separated list of origins allowed to call /api/*.
ALLOWED_ORIGINS=https://crunchyepisode.vercel.app,http://localhost:3000

# Secret used to sign short-lived /api/play access tokens.
# Generate one with: openssl rand -hex 32
VIDEO_SIGNING_SECRET=replace-with-a-long-random-string

# Real video sources — one pair per episode id, matching the keys
# used in api/_data/videoSources.js. Keeping the real URLs in env
# vars (rather than hardcoded in that file) means they never touch
# git history at all.
VIDEO_SRC_CHAINSMOKER_CAT_1X1=https://your-real-cdn.example.com/chainsmoker-cat/1x1/index.html
DOWNLOAD_SRC_CHAINSMOKER_CAT_1X1=https://your-real-cdn.example.com/chainsmoker-cat/1x1/download.mp4

# Your site's real deployed URL. Used to build the download link that
# gets sent to GPLinks for shortening. If unset, falls back to whatever
# host the request came in on (usually fine — only set this if you're
# behind a proxy/custom domain setup where that guess is wrong).
SITE_ORIGIN=https://crunchyepisode.vercel.app

# GPLinks "Developer API" token — auto-shortens every Download button's
# link (see api/_lib/shortener.js and api/download-link.js). Get this
# from your GPLinks account under Tools → Developer API.
# ⚠️ Treat this like a password — never paste it into any file that gets
# committed to git. Set it only here (for local `vercel dev`, and this
# file itself is gitignored) and in Vercel's Environment Variables.
GPLINKS_API_KEY=your-gplinks-developer-api-token
